#!/usr/bin/env bash
set -e

# install packages based on package manager
if command -v pacman >/dev/null; then
  sudo pacman -Sy --needed --noconfirm {{ range .packages.common }}{{ . }} {{ end }}{{ range .packages.linux.arch.pacman }}{{ . }} {{ end }}
  if command -v yay >/dev/null; then
    yay -Sy --needed --noconfirm {{ range .packages.linux.arch.yay }}{{ . }} {{ end }}
  fi
elif command -v apt >/dev/null; then
  echo "Injecting repositories forcing Ubuntu 24.04 (noble) for Linux Mint 22.3..."
  
  # CRITICAL FOR MINT: Force the underlying Ubuntu 24.04 codename so PPAs don't look for 'wilma'
  export DEBIAN_CODENAME=noble
  
  sudo add-apt-repository ppa:lazygit-team/release -y
  sudo add-apt-repository ppa:zhangsongcui3371/fastfetch -y
  sudo add-apt-repository ppa:deadsnakes/ppa -y

  echo "Refreshing APT cache..."
  sudo apt update

  # Convert template lists into a clean Bash array
  RAW_PACKAGES=(
    {{ range .packages.common }}"{{ . }}" {{ end }}
    {{ range .packages.linux.debian.apt }}"{{ . }}" {{ end }}
  )

  echo "Sanitizing and installing APT packages..."
  for pkg in "${RAW_PACKAGES[@]}"; do
    # 1. Skip or replace the libgcc-dev broken name entirely
    if [ "$pkg" = "libgcc-dev" ]; then
      pkg="build-essential"
    fi

    echo "-> Installing: $pkg"
    # '|| true' keeps the loop alive if any other niche package acts up
    sudo apt install -y "$pkg" || echo "WARNING: $pkg failed, skipping."
  done
fi

# Ensure paths exist before executing system switches
if [ -f /usr/bin/fish ]; then
  chsh -s /usr/bin/fish
fi

if command -v playerctld >/dev/null; then
  playerctld daemon
fi

if [ -f ~/.config/wallpaper/mountain.jpg ] && command -v betterlockscreen >/dev/null; then
  betterlockscreen -u ~/.config/wallpaper/mountain.jpg
fi

if command -v npm >/dev/null; then
  sudo npm install -g tree-sitter-cli
fi
