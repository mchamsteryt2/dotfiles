#!/usr/bin/env bash
set -e

# install packages based on package manager
if command -v pacman >/dev/null; then
  sudo pacman -Sy --needed --noconfirm {{ range .packages.common }}{{ . }} {{ end }}{{ range .packages.linux.arch.pacman }}{{ . }} {{ end }}
  if command -v yay >/dev/null; then
    yay -Sy --needed --noconfirm {{ range .packages.linux.arch.yay }}{{ . }} {{ end }}
  fi
elif command -v apt >/dev/null; then
  echo "Adding working repositories for Linux Mint 22.3..."
  
  # Fastfetch and Deadsnakes safely support Noble (Ubuntu 24.04)
  sudo add-apt-repository ppa:zhangsongcui3371/fastfetch -y
  sudo add-apt-repository ppa:deadsnakes/ppa -y

  echo "Refreshing APT cache..."
  sudo apt update

  # Convert template lists into a clean Bash array
  RAW_PACKAGES=(
    {{ range .packages.common }}"{{ . }}" {{ end }}
    {{ range .packages.linux.debian.apt }}"{{ . }}" {{ end }}
  )

  echo "Installing standard APT packages..."
  for pkg in "${RAW_PACKAGES[@]}"; do
    # 1. Skip lazygit in the apt loop (we install it via binary below)
    if [ "$pkg" = "lazygit" ]; then
      continue
    fi

    # 2. Swap the libgcc-dev typo for build-essential
    if [ "$pkg" = "libgcc-dev" ]; then
      pkg="build-essential"
    fi

    echo "-> Installing: $pkg"
    sudo apt install -y "$pkg" || echo "WARNING: $pkg failed, skipping."
  done

  # 3. Safely install lazygit via GitHub Releases Binary (Universal Linux method)
  if ! command -v lazygit >/dev/null; then
    echo "Installing lazygit directly from GitHub..."
    LAZYGIT_VERSION=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
    curl -Lo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz"
    tar xf lazygit.tar.gz lazygit
    sudo install lazygit /usr/local/bin/
    rm -f lazygit lazygit.tar.gz
  fi
fi

# Ensure paths exist before executing shell customisations
if [ -f /usr/bin/fish ]; then
  chsh -s /usr/bin/fish
fi

if command -v playerctld >/dev/null; then
  playerctld daemon
fi

if [ -f ~/.config/wallpaper/mountain.jpg ] && command -v betterlockscreen >/dev/null; then
  betterlockscreen -u ~/.config/wallpaper/mountain.jpg
fi

if command -v npm >/dev/null; then
  sudo npm install -g tree-sitter-cli
fi
